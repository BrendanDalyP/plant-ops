table fact_production
	lineageTag: 550b5965-87fb-53cb-b3b4-7dd2df194bd4

	/// Total good board produced, in square feet: SUM of SquareFeetProduced.
	measure 'Square Feet Produced' = SUM ( fact_production[SquareFeetProduced] )
		displayFolder: Output
		lineageTag: b5479136-4925-567a-83de-8c5f8e7f8d7e

	/// Good square feet attributed to each SKU's current attributes (inactive relationship on SkuId), for 'as the SKU is today' questions.
	measure 'Square Feet Produced (SKU as-is)' = CALCULATE ( [Square Feet Produced], USERELATIONSHIP ( fact_production[SkuId], dim_sku_current[SkuId] ) )
		displayFolder: Output
		lineageTag: f9142006-0411-5751-a0e2-fbbad8bf15dd

	/// Total board scrapped, in square feet.
	measure 'Scrap Square Feet' = SUM ( fact_production[ScrapSquareFeet] )
		displayFolder: Quality
		lineageTag: f42085db-28d2-5650-9570-6c5592371fd1

	/// Share of total board run that was scrapped: scrap square feet divided by good plus scrap square feet. A ratio of sums, never an average of batch rates.
	measure 'Scrap Rate %' = DIVIDE ( [Scrap Square Feet], [Square Feet Produced] + [Scrap Square Feet] )
		formatString: 0.0%
		displayFolder: Quality
		lineageTag: 6cf4b825-bf31-5446-875b-fa2a52e3492b

	column BatchId
		dataType: string
		lineageTag: 3aa9815a-e5db-5a2d-a1b9-acdbc43023ba
