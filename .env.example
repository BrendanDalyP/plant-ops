# PURPOSE     The settings the assistant reads. Copy this file to .env and fill it in from the board.
# PSEUDOCODE  .env is in .gitignore: it stays in your Codespace and never reaches the repo.
#             In Foundry, the hosted agent gets FOUNDRY_PROJECT_ENDPOINT from the platform and the rest from deploy_agent.py.

# The class's Foundry project, and its model deployment (Part 1)
FOUNDRY_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5.4-mini

# The class's toolbox, which holds Ops_Agent (Part 4)
TOOLBOX_ENDPOINT=

# Your hosted agent's name (Part 7)
PLANT_OPS_AGENT_NAME=plant-ops-<initials>
