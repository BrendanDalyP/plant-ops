{
  // The Codespace for the build-along: Python 3.11, the app's packages, Spec Kit, Copilot CLI, and the extensions.
  // Day 5 adds Java 21 and pyspark (the gate notebook's tests run on local Spark) and the Azure CLI (Fabric sign-in).
  "name": "Plant Ops (Copilot build-along)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/node:1": { "version": "22" },
    "ghcr.io/devcontainers/features/java:1": { "version": "21" },
    "ghcr.io/devcontainers/features/azure-cli:1": {}
  },
  "postCreateCommand": "pip install -r requirements-dev.txt && pip install uv==0.11.32 && uv tool install specify-cli==1.2.4 && npm install -g @github/copilot@1.0.102",
  "forwardPorts": [8000],
  "customizations": {
    "vscode": {
      "extensions": [
        "GitHub.copilot-chat",
        "GitHub.vscode-pull-request-github",
        "ms-python.python",
        "charliermarsh.ruff"
      ],
      "settings": {
        "github.copilot.nextEditSuggestions.enabled": true,
        "inlineChat.askInChat": false,
        "chat.editor.localAgent.enabled": true,
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["tests"]
      }
    }
  }
}
